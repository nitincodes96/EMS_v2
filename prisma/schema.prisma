generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  logoURL     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  description    String?
  logoUrl        String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Working hours, slot length, booking limits etc. are no longer per
  // department — they live on the single ScheduleSettings row. Only the
  // geo-fence flag stays here since locations are department-specific.
  geofenceEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations        DepartmentLocation[]
  users            User[]
  holidays         Holiday[]
  leaves           Leave[]
  attendances      Attendance[]
  bookings         Booking[]
  unavailabilities UnavailabilityNotice[]
}

/**
 * Organization-wide work schedule and booking rules. There is exactly one row
 * (id = "global") shared by every department — see lib/schedule-settings.ts.
 */
model ScheduleSettings {
  id String @id @default("global")

  workingDays      String @default("Mon,Tue,Wed,Thu,Fri")
  shiftStartTime   String @default("09:00")
  shiftEndTime     String @default("18:00")
  lateGraceMinutes Int    @default(5)

  // Optional lunch break — slots overlapping this window aren't bookable.
  // Null on both = no break configured.
  lunchStartTime String?
  lunchEndTime   String?

  bookingEnabled Boolean @default(true)

  // Max bookings a faculty may have simultaneously active (status BOOKED).
  // 0 = unlimited.
  facultyBookingLimit Int @default(3)

  // Max consecutive slots a faculty may combine into one booking. 0 = unlimited.
  maxSlotsPerBooking Int @default(0)

  // Length of one bookable slot, in minutes. Drives the booking calendar grid.
  slotDurationMinutes Int @default(30)

  // How many days ahead a faculty may book a PA (today counts as day 0).
  bookingHorizonDays Int @default(7)

  // A booking can only be cancelled or rescheduled up to this many minutes
  // before its start time. 0 = allowed right up until the start time.
  bookingChangeCutoffMinutes Int @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * The work types a faculty can pick when booking a PA. Organization-wide and
 * admin-editable from the Schedule settings dialog. Bookings snapshot the
 * name as plain text, so deleting a type never rewrites history.
 */
model WorkType {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepartmentLocation {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int        @default(100)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

model User {
  id           String      @id @default(uuid())
  email        String?     @unique
  empCode      String?     @unique
  name         String?
  password     String?
  role         Role        @default(PROJECT_ASSISTANT)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  isActive    Boolean    @default(true)
  status      UserStatus @default(INVITED)
  joiningDate DateTime?

  // PA availability (punch-in) — FR-5.1/5.2
  isAvailable       Boolean   @default(false)
  availabilitySince DateTime?

  photoUrl    String?
  phoneNumber String?

  isVerified Boolean   @default(false)
  otp        String?
  otpExpiry  DateTime?

  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaves           Leave[]
  attendances      Attendance[]
  facultyBookings  Booking[]              @relation("FacultyBookings")
  paBookings       Booking[]              @relation("PABookings")
  approvedLeaves   Leave[]                @relation("LeaveApprover")
  notifications    Notification[]
  sessions         UserSession[]
  bookingLogs      BookingLog[]           @relation("BookingLogActor")
  systemLogs       SystemLog[]            @relation("SystemLogActor")
  unavailabilities UnavailabilityNotice[]

  @@index([departmentId])
}

/**
 * A Project Assistant's heads-up that they won't be in — for a whole day or
 * just part of it. Not a leave request: there is no approval, it takes effect
 * immediately. Admins are notified, the affected slots drop off the booking
 * calendar, and faculty holding a booking in that window are told.
 */
model UnavailabilityNotice {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  // "HH:mm" wall-clock bounds. Null on both = unavailable for the whole day.
  startTime String?
  endTime   String?
  reason    String?  @db.Text

  status      UnavailabilityStatus @default(ACTIVE)
  withdrawnAt DateTime?
  // Null when the PA withdrew it themselves; an admin's id when it was
  // reverted for them (the remark is shared with the PA).
  withdrawnById  String?
  withdrawRemark String? @db.Text

  // How many BOOKED bookings overlapped the window when the notice was given
  // (their faculty were notified). Kept for the admin list.
  affectedBookings Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([departmentId, date])
  @@index([status, date])
}

model Leave {
  id           String      @id @default(uuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String?
  status       LeaveStatus @default(PENDING)

  // Approval routing — FR-6.2/6.3/6.4
  approverId     String?
  approver       User?     @relation("LeaveApprover", fields: [approverId], references: [id])
  decisionRemark String?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, status])
  @@index([userId])
  @@index([approverId])
}

model Attendance {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  date              DateTime  @db.Date
  checkInTime       DateTime
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkOutTime      DateTime?
  checkOutLatitude  Float?
  checkOutLongitude Float?

  // FR-3.3: flag when marked outside geofence
  flaggedOutsideGeofence Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([departmentId, date])
}

model Booking {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  facultyId String
  faculty   User   @relation("FacultyBookings", fields: [facultyId], references: [id], onDelete: Cascade)
  paId      String
  pa        User   @relation("PABookings", fields: [paId], references: [id], onDelete: Cascade)

  date      DateTime      @db.Date
  startTime DateTime
  endTime   DateTime
  workType  String?
  task      String        @db.Text
  status    BookingStatus @default(BOOKED)

  // Faculty's 1–5 star rating of the PA's work on this booking, plus the
  // optional written review that came with it
  rating       Int?
  ratedAt      DateTime?
  ratingRemark String?   @db.Text

  // When the PA acknowledged (read) the booking — null = not seen yet. Purely
  // informational for the faculty; a booking is confirmed without it. Cleared
  // on reschedule so the PA re-acknowledges the new slot.
  paAcknowledgedAt DateTime?

  // The PA's own report on the work — null = not reported yet
  paStatus   PaWorkStatus?
  paRemark   String?       @db.Text
  paMarkedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs BookingLog[]

  @@index([departmentId, date])
  @@index([facultyId])
  @@index([paId])
}

model BookingLog {
  id        String           @id @default(uuid())
  bookingId String
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  action    BookingLogAction
  actorId   String?
  actor     User?            @relation("BookingLogActor", fields: [actorId], references: [id])
  message   String           @db.Text
  remark    String?          @db.Text
  createdAt DateTime         @default(now())

  @@index([bookingId])
  @@index([actorId])
}

/**
 * Site-wide audit trail behind the admin System Logs page. Unlike BookingLog
 * (which is scoped to one booking and drives its activity timeline), this
 * records every notable action across auth, users, departments, bookings and
 * leave in one stream. Attendance punches are deliberately excluded — they'd
 * swamp the feed and already have their own page.
 */
model SystemLog {
  id          String            @id @default(uuid())
  category    SystemLogCategory
  action      String
  description String            @db.Text

  // The actor is both linked and snapshotted: the relation powers "everything
  // this user did", while the label/role stay readable after the account is
  // renamed or deleted — which is the whole point of an audit trail.
  actorId    String?
  actor      User?   @relation("SystemLogActor", fields: [actorId], references: [id])
  actorLabel String?
  actorRole  Role?

  // Loose pointer to whatever the event was about. Deliberately not a foreign
  // key, so deleting the booking/leave never erases the record that it happened.
  entityType String?
  entityId   String?

  departmentId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([actorId])
  @@index([departmentId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  refId     String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       String?
  userAgent    String?  @db.Text
  ipAddress    String?
  isSuspended  Boolean  @default(false)
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Holiday {
  id           String      @id @default(uuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  date         DateTime    @db.Date
  type         HolidayType
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([departmentId, name, date])
  @@index([departmentId, date])
}

enum Role {
  ADMIN
  FACULTY
  PROJECT_ASSISTANT
  MODERATOR
}

enum UserStatus {
  INVITED
  ACCEPTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnavailabilityStatus {
  ACTIVE
  WITHDRAWN
}

enum BookingStatus {
  BOOKED
  COMPLETED
  // PA was present/attended, but the work wasn't finished — distinct from
  // ABSENT (PA never reported for the slot).
  INCOMPLETE
  ABSENT
  CANCELLED
}

// The PA's self-report on whether they carried out the booked work.
enum PaWorkStatus {
  DONE
  NOT_DONE
}

enum BookingLogAction {
  CREATED
  RESCHEDULED
  CANCELLED
  COMPLETED
  MARKED_ABSENT
  MARKED_INCOMPLETE
  RATED
  PA_REPORTED
  ACKNOWLEDGED
}

// Buckets the System Logs page filters by.
enum SystemLogCategory {
  AUTH
  USER
  DEPARTMENT
  BOOKING
  LEAVE
  UNAVAILABILITY
}

enum NotificationType {
  GENERAL
  BOOKING
  LEAVE
  UNAVAILABILITY
  SESSION
}

enum HolidayType {
  NATIONAL
  RELIGIOUS
  CUSTOM
}
